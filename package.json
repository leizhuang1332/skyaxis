{
  "name": "@lz/skyaxis",
  "description": "Host-authoritative task board for the DSH Web GUI with real session execution, Host cron scheduling, and optional cross-platform idle-sleep protection; mounted without DSH source changes.",
  "version": "0.3.24",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@tsdown/css": "^0.23.0",
    "@xyflow/react": "^12.10.4",
    "clsx": "^2.1.1",
    "schemastery": "^3.18.0",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^3.2.7",
    "immer": "^10.2.0",
    "jsdom": "^25.0.0",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lz/skyaxis.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "koffi",
      "node-pty"
    ]
  }
}